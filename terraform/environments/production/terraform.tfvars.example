aws_region   = "ap-northeast-1"
project_name = "47log-production"

# リージョン内で一意になる接頭辞と、実際のアプリURLに置き換える。
cognito_domain = "47log-production"
callback_urls  = ["https://app.example.com/auth/callback"]
logout_urls    = ["https://app.example.com/"]

# Googleコンソールで発行した実際のClient IDに置き換える。
google_client_id = "example.apps.googleusercontent.com"

# google_client_secretはファイルに記載せず、TF_VAR_google_client_secret等で渡す。
